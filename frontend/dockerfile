# --- BASE
# A clean image target for Next.js applications
FROM node:24-alpine3.24 AS base

WORKDIR /app

# Installation de pnpm (version figée, doit rester synchro avec "packageManager" dans package.json)
RUN npm install -g pnpm@11.21.0

# --- DEV-DEPENDENCIES
# A target that'll have dev-dependencies installed
FROM base AS dev-dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml pnpm-workspace.yaml ./

RUN pnpm install

# --- PROD-DEPENDENCIES
# A target that'll have only production dependencies installed
FROM base AS prod-dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --production

# --- DEV
# Target for development with hot reload
FROM base AS dev

COPY package.json pnpm-lock.yaml ./
COPY --from=dev-dependencies /app/node_modules ./node_modules

COPY . .

EXPOSE 3000

CMD ["pnpm", "run", "dev"]

# --- BUILD
# Target to build the Next.js application for production
FROM dev-dependencies AS build

# Accept build arguments for Next.js public env vars
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

ARG NEXT_PUBLIC_STRIPE_PUBLIC_KEY
ENV NEXT_PUBLIC_STRIPE_PUBLIC_KEY=$NEXT_PUBLIC_STRIPE_PUBLIC_KEY

COPY . .

RUN pnpm run build

# --- RUNNER
# Target for production runtime
# --- RUNNER
# Target for production runtime
FROM base AS runner

COPY --from=build /app/package.json ./package.json
COPY --from=build /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/public ./public
COPY --from=build /app/.next ./.next

ENV PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false

EXPOSE 3000

CMD ["pnpm", "start"]
